# ──────────────────────────────────────────────────────────────────────────────
# William — environment template.
# Copy to .env on the server (WSL2: ~/william/.env, chmod 600) and fill in.
# setup.sh can also generate this interactively. NEVER commit the real .env.
# Hermes itself reads ~/.hermes/.env; setup.sh symlinks/copies the relevant keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Repo / deploy ────────────────────────────────────────────────────────────
WILLIAM_REPO="https://github.com/Diego-II/william-public.git"   # or your own fork
WILLIAM_BRANCH="main"
WILLIAM_HOME="/home/hermes/william"                   # checkout path in WSL2

# ── Models: default provider = Gemini via Google ─────────────
# Get a key from Google AI Studio (https://aistudio.google.com/apikey)
# or use Vertex with application-default creds (see README).
GEMINI_API_KEY=""
HERMES_PRIMARY_MODEL="gemini-2.5-flash-lite"

# ── Bedrock switch (optional) — used by the on-box LiteLLM proxy ─────────────
# Dedicated IAM user with bedrock:InvokeModel only. Leave blank to disable.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
LITELLM_PORT="8740"
LITELLM_MASTER_KEY="sk-change-me"                     # placeholder: local-only auth for the proxy, set your own
BEDROCK_CHEAP_MODEL="us.amazon.nova-micro-v1:0"
BEDROCK_MID_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"

# ── WhatsApp (Baileys bridge) ────────────────────────────────────────────────
WHATSAPP_ENABLED="true"
WHATSAPP_MODE="bot"
# Comma-separated, country code, NO '+'. Only these numbers/groups get answered.
WHATSAPP_ALLOWED_USERS=""

# ── Web search (optional; Hermes has a built-in browser too) ─────────────────
TAVILY_API_KEY=""

# ── Google Calendar + Gmail MCP tools (one-time OAuth, see README) ───────────
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
GCAL_MCP_PORT="8731"
GMAIL_MCP_PORT="8732"

# ── Backups (optional) ───────────────────────────────────────────────────────
BACKUP_LOCAL_DIR="/home/hermes/william-backups"
BACKUP_S3_BUCKET=""                                   # e.g. my-william-backup; blank = local only
